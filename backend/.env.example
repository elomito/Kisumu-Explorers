# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Frontend origins allowed to call the API (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Leave empty to use local SQLite. On a host, set to the Postgres URL.
DATABASE_URL=
# Leave empty to store images on local disk (media/). Set to use Cloudinary:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
# Admin address, e.g. http://localhost:8000/team-portal/ - pick something only your team knows
ADMIN_URL=team-portal
